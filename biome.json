{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/out",
      "!**/generated",
      "!**/dist",
      "!**/staticfiles",
      "!**/.venv",
      "!**/.turbo",
      "!**/data",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 4,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "bracketSpacing": true,
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnreachable": "error",
        "noConstantCondition": "error",
        "noSwitchDeclarations": "error",
        "noVoidElementsWithChildren": "error",
        "useValidTypeof": "error",
        "noChildrenProp": "error",
        "useJsxKeyInIterable": "error"
      },
      "suspicious": {
        "noDoubleEquals": "error",
        "noDuplicateCase": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error",
        "noSelfCompare": "error",
        "noUnsafeNegation": "error",
        "useAwait": "off",
        "noAsyncPromiseExecutor": "error",
        "noArrayIndexKey": "off"
      }
    }
  },
  "assist": {
    "enabled": false
  }
}
