{
  "name": "docker-api",
  "version": "0.14.2",
  "description": "Docker operations API service for Nexploy — Self-hosted alternative to Vercel/Netlify, powered by Docker",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
