    "@nexploy/shared": "^0.4.0",
    "@workspace/typescript-interface": "workspace:*",
    "byline": "^5.0.0",
    "dayjs": "^1.11.19",
    "dockerode": "^5.0.0",
    "dotenv": "^17.2.3",
    "hono": "4.12.27",
    "ky": "^1.14.1",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "tar-fs": "^3.1.2",
    "ws": "^8.20.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/byline": "^4.2.36",
    "@types/dockerode": "^4.0.1",
