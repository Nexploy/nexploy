PORT=3300
LOG_LEVEL=info

# Path to the Docker daemon Unix socket.
# Colima: ~/.colima/default/docker.sock, Docker Desktop (macOS): ~/.docker/run/docker.sock
DOCKER_SOCKET=/var/run/docker.sock

# Workspace shared with the Nexploy app, where repositories are cloned.
# DEPLOYER_WORK_DIR must match the value set on the Nexploy app side.
# DEPLOYER_WORK_DIR_SOURCE tells docker-api how that path is reachable from the
# Docker daemon: an absolute path for a bind, a plain name for a named volume.
# Leave it empty to let docker-api read the mapping from its own container, which
# is what the production compose file relies on.
DEPLOYER_WORK_DIR=/tmp/deployer
DEPLOYER_WORK_DIR_SOURCE=

NEXPLOY_API_URL=http://localhost:3000
# Shared secret for authenticating requests between docker-api and nexploy.
# Must match the value configured on the Nexploy app side.
NEXPLOY_API_KEY=
# Must match ENCRYPTION_KEY from the Nexploy app's .env — used to authenticate
# docker-api's calls to nexploy's internal routes (key fetch, key verification).
ENCRYPTION_KEY=

# DANGEROUS — exposes Nexploy's own containers, images, networks and volumes in the
# dashboard and lifts every guard on them. Stopping or deleting one of them takes the
# instance down. Set it on the Nexploy app too. Never enable it in production.
# NEXPLOY_DEBUG=true
