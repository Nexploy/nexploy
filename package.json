{
  "name": "nexploy-monorepo",
  "version": "0.12.3",
  "description": "Nexploy - Self-hosted alternative to Vercel/Netlify, powered by Docker",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "turbo run dev --filter=nexploy --filter=docker-api",
    "dev:nexploy": "turbo run dev --filter=nexploy --ui stream",
    "dev:docker-api": "turbo run dev --filter=docker-api --ui stream",
    "build": "turbo run build",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "types": "turbo run typecheck",
    "nodes:local": "node scripts/nodes-source.mjs local",
    "nodes:npm": "node scripts/nodes-source.mjs npm",
    "shared:local": "node scripts/shared-source.mjs local",
    "shared:npm": "node scripts/shared-source.mjs npm",
    "version:set": "node scripts/set-version.mjs",
    "format": "biome format --write .",
    "check-types": "turbo run typecheck",
    "test:api": "turbo run test --filter=nexploy",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": [
      "biome check --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true --colors=off"
    ]
  },
  "dependencies": {
    "@workspace/typescript-config": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@turbo/gen": "^2.9.4",
    "@types/node": "^24.7.2",
    "baseline-browser-mapping": "^2.9.19",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "tsx": "^4.20.6",
    "turbo": "^2.9.4",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13"
  }
}
